# Cache-control rules for platforms that read this file natively
# (Netlify, Cloudflare Pages). GitHub Pages ignores this file, so it has
# no effect on the primary www.f12.biz deployment.
#
# Only fingerprinted/hashed or query-versioned assets get a long,
# immutable cache lifetime — their filename changes whenever the content
# does, so a stale cache can never serve outdated content. Everything
# else keeps the platform default.

/scss/*.css
  Cache-Control: public, max-age=31536000, immutable

/css/bundle.min.*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/js/vendor/*.js
  Cache-Control: public, max-age=31536000, immutable

/js/color-modes.min.*.js
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
